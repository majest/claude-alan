{
  "format_version": "1.8.0",
  "animations": {
    "animation.watcher.walk": {
      "loop": true,
      "bones": {
        "leg_upper_left": {
          "rotation": ["math.cos(query.modified_distance_moved * 19) * 26", 0, 0]
        },
        "leg_upper_right": {
          "rotation": ["-math.cos(query.modified_distance_moved * 19) * 26", 0, 0]
        },
        "arm_upper_left": {
          "rotation": ["-math.cos(query.modified_distance_moved * 19) * 11", 0, "math.sin(query.life_time * 21) * 3 + 4"]
        },
        "arm_upper_right": {
          "rotation": ["math.cos(query.modified_distance_moved * 19) * 11", 0, "-math.sin(query.life_time * 21) * 3 - 4"]
        },
        "body": {
          "rotation": ["math.sin(query.life_time * 26) * 1.5", 0, "math.cos(query.life_time * 17) * 1.2"]
        }
      }
    },

    "animation.watcher.twitch": {
      "loop": true,
      "bones": {
        "arm_lower_left": {
          "rotation": ["math.sin(query.life_time * 47) * 13", "math.cos(query.life_time * 29) * 7", 0]
        },
        "arm_lower_right": {
          "rotation": ["math.sin(query.life_time * 41 + 90) * 13", "math.cos(query.life_time * 33 + 40) * 7", 0]
        },
        "claw_left": {
          "rotation": ["math.sin(query.life_time * 88) * 9", 0, "math.cos(query.life_time * 63) * 6"]
        },
        "claw_right": {
          "rotation": ["math.sin(query.life_time * 79 + 60) * 9", 0, "math.cos(query.life_time * 57 + 30) * 6"]
        },
        "leg_lower_left": {
          "rotation": ["math.sin(query.life_time * 24) * 5", 0, 0]
        },
        "leg_lower_right": {
          "rotation": ["math.sin(query.life_time * 21 + 110) * 5", 0, 0]
        }
      }
    },

    "animation.watcher.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0]
        },
        "neck": {
          "rotation": [0, "query.target_y_rotation * 0.25", 0]
        }
      }
    }
  }
}
